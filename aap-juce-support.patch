diff --git a/src/main/AAPFactoryStandalone.cpp b/src/main/AAPFactoryStandalone.cpp
new file mode 100644
index 0000000..32aeca5
--- /dev/null
+++ b/src/main/AAPFactoryStandalone.cpp
@@ -0,0 +1,16 @@
+#include <jni.h>
+
+namespace aap
+{
+JavaVM* get_android_jvm();
+}
+
+extern "C" jint JNI_GetCreatedJavaVMs(JavaVM** vmBuf, jsize nVMs, jsize* nVMsFound)
+{
+    auto* vm = aap::get_android_jvm();
+    if (nVMsFound != nullptr)
+        *nVMsFound = vm == nullptr ? 0 : 1;
+    if (vm != nullptr && vmBuf != nullptr && nVMs > 0)
+        vmBuf[0] = vm;
+    return vm == nullptr ? JNI_ERR : JNI_OK;
+}
